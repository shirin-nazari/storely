generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String? @unique
  password  String
  cart      Cart?
  orders    Order[]
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  price       Float
  description String
  images      String[]
  category    String
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart Cart @relation(fields: [cartId],references: [id])
}

model Cart {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  userId String      @unique
  user   User        @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  items     Json
  total     Float
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}